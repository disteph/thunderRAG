opam-version: "2.0"
synopsis:
  "Local RAG server for email: ingestion, triage, vector search, and LLM-assisted reply drafting"
maintainer: ["Stéphane Graham-Lengrand <stephane.graham-lengrand@sri.com>"]
authors: ["Stéphane Graham-Lengrand <stephane.graham-lengrand@sri.com>"]
license: "MIT"
homepage: "https://github.com/disteph/thunderRAG"
bug-reports: "https://github.com/disteph/thunderRAG/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.13" & >= "3.13"}
  "eio_main"
  "cohttp-eio"
  "uri"
  "yojson"
  "mrmime"
  "angstrom"
  "bigstringaf"
  "lambdasoup"
  "logs"
  "fmt"
  "caqti"
  "caqti-eio"
  "caqti-driver-postgresql"
  "pg_query"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/disteph/thunderRAG.git"
